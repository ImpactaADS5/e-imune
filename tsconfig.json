{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleDetection": "force",
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true,
        "noEmitOnError": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "strict": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/**/__tests__/**",
        "src/**/*.test.ts",
        "src/**/*.spec.ts"
    ]
}