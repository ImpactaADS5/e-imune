// Schema de referência para a sprint (provider sqlite só para teste local).
// No projeto real, mantenha o "provider" e a "url" que o time de back já usa
// e acrescente APENAS o campo `proximaDose` em VaccineRecord.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(uuid())
  nome           String
  email          String          @unique
  dataNascimento DateTime
  senha          String
  createdAt      DateTime        @default(now())
  records        VaccineRecord[]
}

model Vaccine {
  id                String          @id @default(uuid())
  nome              String
  fabricante        String?
  dosesRecomendadas Int?
  records           VaccineRecord[]
}

model VaccineRecord {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  vaccineId     String
  vaccine       Vaccine  @relation(fields: [vaccineId], references: [id])
  dose          String?
  dataAplicacao DateTime
  proximaDose   DateTime? // NOVO: data prevista da próxima dose (opcional)
  local         String?
  lote          String?
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, vaccineId])
}
